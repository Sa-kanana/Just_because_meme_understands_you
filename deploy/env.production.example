# 单机生产部署模板：复制为 deploy/.env 并只在服务器填写真实密钥。
# 所有服务只读取自己需要的变量；本文件不会被打包进镜像。

# ---------- Compose 入口与基础设施凭据 ----------
# Nginx 在服务器上监听的地址；0.0.0.0 表示允许从公网网卡访问，内网代理场景可改为 127.0.0.1。
HTTP_BIND_ADDRESS=0.0.0.0
# Nginx 映射到服务器的 HTTP 端口；端口冲突时可改为 8081，并在云安全组和系统防火墙放行该端口。
HTTP_PORT=80
# MySQL、Redis、PostgreSQL 在服务器上绑定的地址；保持 127.0.0.1，通过 SSH 隧道安全访问数据库。
DATABASE_BIND_ADDRESS=127.0.0.1
# MySQL 在服务器本机发布的端口；SSH 隧道的远端目标端口与此值相同。
MYSQL_HOST_PORT=3306
# Redis 在服务器本机发布的端口；SSH 隧道的远端目标端口与此值相同。
REDIS_HOST_PORT=6379
# PostgreSQL 在服务器本机发布的端口；SSH 隧道的远端目标端口与此值相同。
POSTGRES_HOST_PORT=5432
# MemeAgent 镜像构建时使用的 Python 包源；服务器无法访问时可换成可用的 PyPI 镜像。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# Spring Boot JVM 参数；2 GiB 试运行的堆上限为 320 MiB，扩容后可提高。
JAVA_OPTS=-Xms128m -Xmx320m -XX:+UseContainerSupport
# 容器健康检查最长等待秒数；镜像下载和构建时间不计入该值。
DEPLOY_WAIT_TIMEOUT_SECONDS=900
# MySQL 容器内存上限，需大于缓冲池和各连接所需内存。
MYSQL_MEMORY_LIMIT=384m
# InnoDB 数据缓冲池容量。
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
# MySQL 最大连接总数。
MYSQL_MAX_CONNECTIONS=60
# 小内存试运行关闭性能采集；扩容后按需改为 ON。
MYSQL_PERFORMANCE_SCHEMA=OFF
# Spring Boot 业务连接池最大连接数。
DB_POOL_MAX_SIZE=5
# Spring Boot 业务连接池初始空闲连接数。
DB_POOL_MIN_IDLE=1
# Redis 容器总内存上限，需为 AOF 与客户端缓冲区留出空间。
REDIS_MEMORY_LIMIT=128m
# Redis 数据内存上限；超过上限拒绝写入，不淘汰登录和任务状态。
REDIS_MAXMEMORY=80mb
# PostgreSQL 容器内存上限；大量 HNSW 索引构建时需要提高。
POSTGRES_MEMORY_LIMIT=256m
# PostgreSQL 共享缓冲区容量。
POSTGRES_SHARED_BUFFERS=48MB
# PostgreSQL 最大连接数，需高于 MemeAgent 向量连接池上限。
POSTGRES_MAX_CONNECTIONS=30
# FastAPI 容器内存上限。
MEME_AGENT_MEMORY_LIMIT=384m
# Spring Boot 容器总内存上限，包含堆、线程栈、元空间及直接内存。
BACKEND_MEMORY_LIMIT=640m
# Nginx 容器内存上限。
NGINX_MEMORY_LIMIT=64m
# MySQL root 管理密码；使用 openssl rand -hex 32 生成 URL 安全随机值。
MYSQL_ROOT_PASSWORD=REPLACE_ME_WITH_RANDOM_HEX
# Spring Boot 专用 MySQL 账号名。
MYSQL_APP_USER=meme_app
# Spring Boot 专用 MySQL 密码；使用 openssl rand -hex 32 生成。
MYSQL_APP_PASSWORD=REPLACE_ME_WITH_RANDOM_HEX
# Redis 访问密码；使用 openssl rand -hex 32 生成。
REDIS_PASSWORD=REPLACE_ME_WITH_RANDOM_HEX
# PostgreSQL/MemeAgent 数据库账号名。
POSTGRES_USER=memeagent
# PostgreSQL 数据库名。
POSTGRES_DB=memeagent_vector
# PostgreSQL 持久化卷名称；常规更新固定不变，大版本升级使用新卷而不覆盖旧卷。
POSTGRES_VOLUME_NAME=just-because-meme_postgres-data
# PostgreSQL 密码会嵌入连接 URL，必须使用不含保留字符的十六进制值。
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM_HEX
# Java 与 MemeAgent 共享的内部 API 密钥；使用 openssl rand -hex 32 生成。
MEME_AGENT_API_KEY=REPLACE_ME_WITH_RANDOM_HEX
# 可选的 MemeAgent 写接口独立密钥；留空时与上方内部 API 密钥相同。
MEME_AGENT_WRITE_API_KEY=

# ---------- 邮件服务（验证码和找回密码） ----------
# SMTP 服务主机名。
MAIL_HOST=smtp.qq.com
# SMTP SSL 端口。
MAIL_PORT=465
# SMTP 邮箱账号；不启用邮件功能时留空。
MAIL_USERNAME=
# SMTP 邮箱授权码；不启用邮件功能时留空。
MAIL_PASSWORD=

# ---------- 阿里云 OSS（发布图片和文件必须配置） ----------
# OSS Bucket 所在地域的服务端点。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS AccessKey ID。
OSS_ACCESS_KEY_ID=REPLACE_ME
# OSS AccessKey Secret。
OSS_ACCESS_KEY_SECRET=REPLACE_ME
# 图片和文件所在的 OSS Bucket 名称。
OSS_BUCKET_NAME=REPLACE_ME
# OSS 浏览器直传地址；没有自定义上传域名时留空。
OSS_UPLOAD_HOST=
# 图片公开访问基址；没有自定义 CDN 域名时留空。
OSS_PUBLIC_BASE_URL=

# ---------- JWT、安全与同源访问 ----------
# JWT 签名密钥，至少 32 字节；使用 openssl rand -hex 32 生成。
JWT_SECRET=REPLACE_ME_WITH_RANDOM_HEX
# HTTP 部署保持 false；部署 HTTPS 后改成 true。
JWT_COOKIE_SECURE=false
# Access Token 有效期，单位毫秒。
JWT_EXPIRATION=7200000
# Refresh Token 有效期，单位毫秒。
JWT_REFRESH_EXPIRATION=604800000
# Vue 与 API 由同源 Nginx 提供，默认关闭 CORS。
CORS_ENABLED=false
# 后端配置仍要求 Origin；部署时改为实际访问地址，例如 https://meme.example.com。
CORS_ALLOWED_ORIGINS=http://localhost
# 可选的 CORS 通配 Origin 列表。
CORS_ALLOWED_ORIGIN_PATTERNS=
# 安全响应头开关。
SECURITY_HEADERS_ENABLED=true
# HTTP 部署关闭 HSTS；HTTPS 部署后改成 true。
HSTS_ENABLED=false
# 用户反馈收件邮箱；留空时使用代码中的默认地址。
FEEDBACK_TO_EMAIL=
# 每个 IP 每分钟允许提交的反馈数量。
FEEDBACK_RATE_LIMIT_PER_MINUTE=3

# ---------- GitHub OAuth（可选） ----------
# GitHub OAuth App 的 Client ID。
GITHUB_CLIENT_ID=
# GitHub OAuth App 的 Client Secret。
GITHUB_CLIENT_SECRET=
# 必须与 GitHub OAuth App 回调地址一致，生产环境替换 localhost。
GITHUB_REDIRECT_URI=http://localhost/api/v1/auth/oauth/github/callbacks
# OAuth 登录成功后浏览器回到前端的地址。
GITHUB_FRONTEND_CALLBACK_URL=http://localhost/login/oauth/callback
# GitHub OAuth 请求权限范围。
GITHUB_OAUTH_SCOPE=read:user user:email
# 首次部署时可填写已注册邮箱，将该用户初始化为超级管理员；完成后可清空。
AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ---------- MemeAgent 模型与向量检索 ----------
# OpenAI 兼容服务 API 密钥。
OPENAI_API_KEY=REPLACE_ME
# OpenAI 兼容服务地址；按服务商文档填写，OpenAI 可用 https://api.openai.com/v1。
OPENAI_BASE_URL=https://api.openai.com/v1
# 对话模型名称。
OPENAI_CHAT_MODEL=gpt-4o-mini
# 向量 Embedding 模型名称；必须与向量维度配置匹配。
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding 模型输出维度；必须与所用模型返回维度一致。
VECTOR_EMBEDDING_DIM=1536
# 向量检索的最低余弦相似度。
VECTOR_MIN_SIMILARITY=0.6322177756757377
# 向量候选检索数量上限。
RETRIEVAL_TOP_K=5
# 单次检索超时秒数。
RETRIEVAL_TIMEOUT_SECONDS=12
# 检索失败后的额外重试次数。
RETRIEVAL_MAX_RETRIES=1
# 会话检索词改写最长等待秒数。
RETRIEVAL_QUERY_REWRITE_TIMEOUT_SECONDS=5
# 搜索 Agent 单次请求整体超时秒数。
AGENT_TOTAL_TIMEOUT_SECONDS=120
# 模型单次请求超时秒数。
LLM_REQUEST_TIMEOUT_SECONDS=35
# 模型调用失败后的额外重试次数。
LLM_MAX_RETRIES=2
# 是否启用模型供应商支持的流式 Token 用量统计。
LLM_STREAM_USAGE=false
# 查询向量缓存最多保存的条数；设为 0 可关闭。
EMBEDDING_CACHE_MAX_ENTRIES=128
# 查询向量缓存有效秒数；设为 0 可关闭。
EMBEDDING_CACHE_TTL_SECONDS=300
# 管理知识库纯向量召回相似度下限；留空表示关闭该候选来源。
ADMIN_KNOWLEDGE_MIN_SIMILARITY=

# ---------- MemeAgent 知识库索引 ----------
# 单个知识片段字符数。
KNOWLEDGE_CHUNK_SIZE=1000
# 相邻知识片段重叠字符数。
KNOWLEDGE_CHUNK_OVERLAP=160
# 单份知识正文最大字符数。
KNOWLEDGE_MAX_CONTENT_CHARS=1000000
# 知识向量 Embedding 并发批次数。
KNOWLEDGE_EMBEDDING_BATCH_CONCURRENCY=1
# 未完成知识索引检查点保留天数。
KNOWLEDGE_EMBEDDING_CHECKPOINT_TTL_DAYS=7
# FastAPI 单进程 PostgreSQL 连接池下限。
VECTOR_POOL_MIN_SIZE=1
# FastAPI 单进程 PostgreSQL 连接池上限。
VECTOR_POOL_MAX_SIZE=5
# 等待 PostgreSQL 空闲连接的最长秒数。
VECTOR_POOL_ACQUIRE_TIMEOUT_SECONDS=5
# PostgreSQL 单条命令超时秒数。
VECTOR_DB_COMMAND_TIMEOUT_SECONDS=30

# ---------- 可选 LangSmith 调用追踪 ----------
# 是否记录模型调用链路；不使用追踪服务时保持 false。
LANGCHAIN_TRACING_V2=false
# LangSmith API 密钥；未启用追踪时留空。
LANGCHAIN_API_KEY=
# LangSmith 项目名称。
LANGCHAIN_PROJECT=memeagent

# ---------- Firecrawl 热梗采集（默认关闭） ----------
# 是否启用后台 Firecrawl 热梗采集；启用前先配置 API Key。
FIRECRAWL_ENABLED=false
# Firecrawl API 密钥。
FIRECRAWL_API_KEY=
# 单次采集最长秒数。
FIRECRAWL_CRAWL_TOTAL_TIMEOUT_SECONDS=150
# B 站投稿页面地址。
FIRECRAWL_BILIBILI_UPLOAD_URL=https://space.bilibili.com/94510621/upload/video
# B 站投稿页采集视频数量。
FIRECRAWL_BILIBILI_TOP_VIDEOS=5
# Firecrawl 页面抓取代理模式。
FIRECRAWL_SCRAPE_PROXY=stealth
# B 站主页动态地址。
FIRECRAWL_BILIBILI_DYNAMIC_URL=https://space.bilibili.com/94510621
# B 站追加采集地址；多项使用英文逗号分隔。
FIRECRAWL_BILIBILI_EXTRA_URLS=https://space.bilibili.com/94510621/dynamic
# 无梗结果时使用的站内兜底搜索词，以竖线分隔。
FIRECRAWL_DEFAULT_QUERIES=网络流行语|网络梗

# ---------- Spring Boot AI、上传和 OSS 清理 ----------
# MemeAgent 上游连接建立超时毫秒。
MEME_AGENT_CONNECT_TIMEOUT_MS=2000
# Java 读取 MemeAgent 响应超时毫秒。
MEME_AGENT_RESPONSE_TIMEOUT_MS=1200000
# Java 到 MemeAgent 的最大活动连接数。
MEME_AGENT_MAX_CONNECTIONS=100
# Java 等待 MemeAgent 连接的最大排队请求数。
MEME_AGENT_PENDING_ACQUIRE_MAX_COUNT=200
# 等待 MemeAgent 上游连接的最长毫秒数。
MEME_AGENT_PENDING_ACQUIRE_TIMEOUT_MS=10000
# 知识向量索引并发任务数。
MEME_AGENT_KNOWLEDGE_INDEX_CONCURRENCY=1
# AI 对话历史最大 Token 估算值。
MEME_AI_MAX_HISTORY_TOKENS=3000
# AI 回复最大 Token 数。
MEME_AI_MAX_OUTPUT_TOKENS=512
# AI 回复缓存有效秒数。
MEME_AI_CACHE_TTL_SECONDS=120
# AI SSE 相邻事件最长空闲毫秒数。
MEME_AI_STREAM_IDLE_TIMEOUT_MS=130000
# 后台 AI 生成任务和事件保留秒数。
MEME_AI_TASK_TTL_SECONDS=600
# 单用户 AI 搜索每分钟请求上限。
MEME_AI_RATE_LIMIT_PER_MINUTE=20
# 字符数换算 Token 数时的估算比例。
MEME_AI_CHARS_PER_TOKEN=3
# 单份知识文件最大体积。
KNOWLEDGE_UPLOAD_MAX_FILE_SIZE=25MB
# 单份知识正文最大字符数。
KNOWLEDGE_UPLOAD_MAX_CONTENT_CHARS=1000000
# 同时解析的知识上传请求数上限。
KNOWLEDGE_UPLOAD_MAX_CONCURRENT_REQUESTS=1
# 知识上传等待并发槽位的最长毫秒数。
KNOWLEDGE_UPLOAD_ADMISSION_WAIT_MS=30000
# OSS 临时资产清理任务开关。
OSS_CLEANUP_ENABLED=true
# 每轮 OSS 清理对象数上限。
OSS_CLEANUP_BATCH_SIZE=100
# OSS 清理任务轮询间隔毫秒。
OSS_CLEANUP_POLL_INTERVAL_MS=60000
# 删除 OSS 对象前的延迟天数。
OSS_CLEANUP_DELETION_DELAY_DAYS=2
# OSS 清理失败最大重试次数。
OSS_CLEANUP_MAX_RETRIES=5
# OSS 清理分布式任务租约秒数。
OSS_CLEANUP_LEASE_SECONDS=300
# 是否将存量 OSS 对象回填为文件资产。
OSS_BACKFILL_ENABLED=true
# OSS 资产回填每批对象数。
OSS_BACKFILL_BATCH_SIZE=200
# OSS 资产回填轮询间隔毫秒。
OSS_BACKFILL_POLL_INTERVAL_MS=1000
# OSS 资产回填任务租约秒数。
OSS_BACKFILL_LEASE_SECONDS=300
# OSS 临时对象每日清理时间。
OSS_TEMP_CLEANUP_CRON=0 0 3 * * *
# 临时 OSS 对象允许保留天数。
OSS_TEMP_ASSET_TTL_DAYS=3
# OSS 孤儿对象人工复核等待天数。
OSS_ORPHAN_REVIEW_DAYS=7
# OSS 对账默认为只读预览模式。
OSS_RECONCILE_DRY_RUN=true
# OSS 全量对账开关，首次部署默认关闭。
OSS_RECONCILE_ENABLED=false
# OSS 全量对账任务 Cron 表达式。
OSS_RECONCILE_CRON=0 30 3 * * *
# OSS 对账单次读取的最大对象数。
OSS_RECONCILE_PAGE_SIZE=500
# OSS 直传签名策略每 IP 每分钟限额。
OSS_POLICY_RATE_LIMIT_PER_MINUTE=10
# MemeAgent 管理接口是否要求管理员权限。
MEME_OPS_REQUIRE_ADMIN=true
# 是否启用 Java 定时采集任务；默认关闭。
MEME_CRAWL_ENABLED=false
# 是否启用热梗采集计划；默认关闭。
MEME_CRAWL_SCHEDULE_ENABLED=false
# 热梗采集 Cron 表达式。
MEME_CRAWL_CRON=0 0 10 1,8,15,22 * *
# 单次热梗采集数量上限。
MEME_CRAWL_LIMIT=5
# 创建采集梗时使用的发布用户雪花 ID。
MEME_CRAWL_PUBLISHER_USER_ID=0
# 热梗候选数量上限。
MEME_CRAWL_LIVE_LIMIT=8
# 热梗候选时间范围小时数。
MEME_CRAWL_LIVE_HOURS=48
