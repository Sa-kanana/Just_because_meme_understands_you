# 用户端 Vue 3 静态资源构建阶段。
FROM node:22-alpine AS web-build
WORKDIR /workspace
COPY Just_because_meme_understands_you-frontend/package.json Just_because_meme_understands_you-frontend/package-lock.json ./
RUN npm ci
COPY Just_because_meme_understands_you-frontend/ ./
ARG VUE_APP_API_BASE_URL=/api
ENV VUE_APP_API_BASE_URL=${VUE_APP_API_BASE_URL}
RUN npm run build

# 管理端 Vue 静态资源构建阶段，vue.config.js 会输出 /admin/ 资源路径。
FROM node:22-alpine AS admin-build
WORKDIR /workspace
COPY just_because_meme_understands_you-admin/package.json just_because_meme_understands_you-admin/package-lock.json ./
RUN npm ci
COPY just_because_meme_understands_you-admin/ ./
RUN npm run build

# Nginx 运行阶段同时托管两个 Vue SPA 并反向代理 Spring Boot API。
FROM nginx:stable-alpine AS runtime
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /workspace/dist/ /usr/share/nginx/html/
COPY --from=admin-build /workspace/dist/ /usr/share/nginx/html/admin/

# 声明唯一需要映射到服务器公网的 HTTP 端口。
EXPOSE 80
