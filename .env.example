# =============================================================================
# Docker / 生产环境变量模板（可提交）
# 用法：复制为仓库根目录 .env 后填写；docker compose 会自动读取同目录 .env
# .env 已在 .gitignore，勿提交真实值。
# =============================================================================

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL（容器内主机名常用 mysql）
DB_URL=jdbc:mysql://mysql:3306/meme?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=

# Redis（容器内主机名常用 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮箱
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# 阿里云 OSS（直传落 tmp/；控制台需为 tmp/ 配置生命周期，建议 3 天过期）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_UPLOAD_HOST=
OSS_PUBLIC_BASE_URL=

# JWT（至少 32 字节随机串）
JWT_SECRET=
JWT_COOKIE_SECURE=true

# 安全 / CORS（正式前端域名，逗号分隔）
CORS_ALLOWED_ORIGINS=https://www.example.com
TRUSTED_PROXIES=
HSTS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CORS_ENABLED=true

# 用户反馈收件邮箱
FEEDBACK_TO_EMAIL=827278063@qq.com
FEEDBACK_RATE_LIMIT_PER_MINUTE=3

# GitHub OAuth（登录）
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用
# Authorization callback URL 须与 GITHUB_REDIRECT_URI 一致
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/v1/auth/oauth/github/callbacks
GITHUB_FRONTEND_CALLBACK_URL=http://localhost/login/oauth/callback

# ---------- MemeAgent（FastAPI，仅内网）----------
MEME_AGENT_BASE_URL=http://127.0.0.1:8000
MEME_AGENT_API_KEY=
# Java 调用 MemeAgent 的响应读取超时时间（毫秒），默认 20 分钟
MEME_AGENT_RESPONSE_TIMEOUT_MS=1200000
# 知识向量 outbox 同时处理的不同文档数，范围 1–8，默认 2。
MEME_AGENT_KNOWLEDGE_INDEX_CONCURRENCY=2
# 知识文件单份最多 25 MB；如调低该值，应同步保持 max-request-size 高于单文件上限。
KNOWLEDGE_UPLOAD_MAX_FILE_SIZE=25MB
# 知识正文最多允许 1,000,000 个字符，超限时拒绝而不截断。
KNOWLEDGE_UPLOAD_MAX_CONTENT_CHARS=1000000
# 同一实例同时解析的 multipart 请求数，默认 2。
KNOWLEDGE_UPLOAD_MAX_CONCURRENT_REQUESTS=2
# 上传请求等待内存并发槽位的最长时间（毫秒）。
KNOWLEDGE_UPLOAD_ADMISSION_WAIT_MS=30000
# Java 到 MemeAgent 的 SSE 上游连接池最大连接数和最大等待队列数
MEME_AGENT_MAX_CONNECTIONS=100
MEME_AGENT_PENDING_ACQUIRE_MAX_COUNT=200
# 等待 MemeAgent 上游连接可用的最长毫秒数
MEME_AGENT_PENDING_ACQUIRE_TIMEOUT_MS=10000
MEME_AI_MAX_HISTORY_TOKENS=3000
MEME_AI_MAX_OUTPUT_TOKENS=512
MEME_AI_CACHE_TTL_SECONDS=120
MEME_AI_RATE_LIMIT_PER_MINUTE=20
MEME_AI_BACKFILL_ENABLED=true

# Firecrawl 热梗采集（Java 调度 → MemeAgent）
MEME_CRAWL_ENABLED=true
MEME_CRAWL_SCHEDULE_ENABLED=true
MEME_CRAWL_LIMIT=8
MEME_CRAWL_PUBLISHER_USER_ID=
MEME_CRAWL_LIVE_LIMIT=8
MEME_CRAWL_LIVE_HOURS=48

