# =============================================================================
# Docker / 生产环境变量模板（可提交）
# 用法：复制为仓库根目录 .env 后填写；docker compose 会自动读取同目录 .env
# .env 已在 .gitignore，勿提交真实值。
# =============================================================================

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL（容器内主机名常用 mysql）
DB_URL=jdbc:mysql://mysql:3306/MemeLIst?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=

# Redis（容器内主机名常用 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮箱
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_UPLOAD_HOST=
OSS_PUBLIC_BASE_URL=

# JWT（至少 32 字节随机串）
JWT_SECRET=
JWT_COOKIE_SECURE=true

# 安全 / CORS（正式前端域名，逗号分隔）
CORS_ALLOWED_ORIGINS=https://www.example.com
TRUSTED_PROXIES=
HSTS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CORS_ENABLED=true
