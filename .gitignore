.ci-validation-*/
build/
out/
# 部署配置纳入版本管理，只忽略部署密钥和本机构建产物。
deploy/.env
deploy/meme-agent.env
deploy/artifacts/
# 忽略 docs 目录；已纳入版本管理的文件仍保持跟踪。
/docs/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

