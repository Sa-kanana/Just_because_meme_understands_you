# =============================================================================
# 开发环境模板（可提交仓库）
# 复制为同目录 application-dev.yml 后填写真实值。
# application-dev.yml 已在 .gitignore，请勿提交含密钥的实文件。
# =============================================================================

server:
  port: 8080

spring:
  # ---------- 邮箱 ----------
  mail:
    host: smtp.qq.com
    port: 465
    username: # 请自行填写：QQ 邮箱
    password: # 请自行填写：QQ 邮箱 16 位授权码

  # ---------- MySQL ----------
  datasource:
    username: root
    password: # 请自行填写：数据库密码
    url: jdbc:mysql://127.0.0.1:3306/MemeLIst?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

  # ---------- Redis ----------
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      # password: # 有密码则取消注释并填写

# ---------- 阿里云 OSS ----------
# 直传落 tmp/；请在控制台为前缀 tmp/ 配置生命周期规则（建议 3 天过期删除）
oss:
  endpoint: oss-cn-beijing.aliyuncs.com
  accessKeyId: # 请自行填写
  accessKeySecret: # 请自行填写
  bucketName: # 请自行填写
  uploadHost: # 可选
  publicBaseUrl: # 可选

# ---------- JWT（仅开发）----------
jwt:
  secret: just_because_meme_understands_you_jwt_secret_dev_only
  cookie-secure: false

# ---------- 本地安全 / CORS ----------
app:
  security:
    trusted-proxies:
    headers:
      enabled: true
      hsts-enabled: false
  cors:
    enabled: true
    allowed-origins: http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:8080
  feedback:
    to-email: 827278063@qq.com
    rate-limit-per-minute: 3
  oauth:
    github:
      client-id: # 请自行填写 GitHub OAuth App Client ID
      client-secret: # 请自行填写 GitHub OAuth App Client Secret
      # GitHub 应用回调须指向后端（不要走前端代理）
      redirect-uri: http://localhost:8080/login/oauth/github/callback
      # 本地前端（vue serve 默认 80 端口）
      frontend-callback-url: http://localhost/login/oauth/callback
      scope: read:user user:email

# ---------- MemeAgent（FastAPI AI 搜索）----------
meme:
  agent:
    base-url: http://127.0.0.1:8000
    api-key: # 请自行填写，与 MemeAgent INTERNAL_API_KEY 一致
    # write-api-key: # 可选；与 INTERNAL_API_KEY_WRITE 一致，空则回退 api-key
  ai:
    max-history-tokens: 3000
    max-output-tokens: 512
    cache-ttl-seconds: 120
    rate-limit-per-minute: 20
    chars-per-token-estimate: 3
    backfill-enabled: true
  ops:
    require-admin: true
    # 本地无 ROLE_ADMIN 时可把本人 userId 加入白名单
    admin-user-ids: []

# ---------- Firecrawl 热梗采集 ----------
meme:
  agent:
    base-url: http://127.0.0.1:8000
    api-key: # 与 MemeAgent INTERNAL_API_KEY 一致
  crawl:
    enabled: true
    schedule-enabled: true
    # 每月 4 次：1/8/15/22 日 10:00
    cron: '0 0 10 1,8,15,22 * *'
    publisher-user-id: # 请填写已存在的用户雪花 ID
    limit: 5
    live-limit: 8
    live-hours: 48

