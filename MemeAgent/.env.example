# MemeAgent 本地配置示例 — 复制为 .env 后填写，勿提交 .env

APP_NAME=meme-agent
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Java ↔ Agent 内部鉴权（与 Java meme.agent.api-key 一致）
INTERNAL_API_KEY=meme-agent-key

# PostgreSQL + pgvector（与业务 MySQL 隔离）
# 必须带用户名密码，格式：postgresql://USER:PASSWORD@HOST:PORT/DB
# 缺少账号时 asyncpg 会用系统用户名，导致 password authentication failed
VECTOR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres
# 必须与实际 embedding 模型返回的向量维度一致
VECTOR_EMBEDDING_DIM=1024
# 每个 MemeAgent worker 的 PostgreSQL 连接池最小/最大连接数；总连接数约为 worker 数乘以最大连接数
VECTOR_POOL_MIN_SIZE=1
VECTOR_POOL_MAX_SIZE=10
# 等待空闲数据库连接的最长秒数，以及单条 PostgreSQL 命令的超时秒数
VECTOR_POOL_ACQUIRE_TIMEOUT_SECONDS=5
VECTOR_DB_COMMAND_TIMEOUT_SECONDS=30
# 查询向量缓存最多条数及有效秒数；高敏感部署可设为 0 关闭缓存
EMBEDDING_CACHE_MAX_ENTRIES=128
EMBEDDING_CACHE_TTL_SECONDS=300

# OpenAI 兼容 API（embedding + chat）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 模型单次请求超时（秒）与最多重试次数（不含首次请求）
LLM_REQUEST_TIMEOUT_SECONDS=35
LLM_MAX_RETRIES=2
# 流式 token 用量统计开关：供应商不支持时保持 false
LLM_STREAM_USAGE=false

# LangSmith（可选；支持 LANGSMITH_* 或 LANGCHAIN_*）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memeagent

# 检索 / 生成
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=512
# 站内检索单次超时（秒）与最多重试次数（不含首次请求）
RETRIEVAL_TIMEOUT_SECONDS=12
RETRIEVAL_MAX_RETRIES=1
# 实时联网工具单次超时（秒，不自动重试）
LIVE_WEB_TIMEOUT_SECONDS=25
# Python 搜索 Agent 整条请求的总时限（秒）
AGENT_TOTAL_TIMEOUT_SECONDS=120

# Firecrawl（实时热梗采集 / Agent 联网；可留空走 keyless 限流）
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true
# B 站投稿页（Firecrawl actions 交互滚动）→ 取前 N 条视频梗
FIRECRAWL_BILIBILI_UPLOAD_URL=https://space.bilibili.com/94510621/upload/video
FIRECRAWL_BILIBILI_TOP_VIDEOS=5
FIRECRAWL_SCRAPE_PROXY=stealth
# 主页 / 动态兜底
FIRECRAWL_BILIBILI_DYNAMIC_URL=https://space.bilibili.com/94510621
FIRECRAWL_BILIBILI_EXTRA_URLS=https://space.bilibili.com/94510621/dynamic
# B 站无梗时的站内搜索兜底关键词，多条用 | 分隔
FIRECRAWL_DEFAULT_QUERIES=网络流行语|网络梗
