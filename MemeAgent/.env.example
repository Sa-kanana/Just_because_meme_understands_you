# MemeAgent 本地配置示例 — 复制为 .env 后填写，勿提交 .env

APP_NAME=meme-agent
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Java ↔ Agent 内部鉴权（与 Java meme.agent.api-key 一致）
INTERNAL_API_KEY=meme-agent-key

# PostgreSQL + pgvector（与业务 MySQL 隔离）
# 必须带用户名密码，格式：postgresql://USER:PASSWORD@HOST:PORT/DB
# 缺少账号时 asyncpg 会用系统用户名，导致 password authentication failed
VECTOR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres
VECTOR_EMBEDDING_DIM=1536

# OpenAI 兼容 API（embedding + chat）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith（可选；支持 LANGSMITH_* 或 LANGCHAIN_*）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memeagent

# 检索 / 生成
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=512

# Firecrawl（实时热梗采集 / Agent 联网；可留空走 keyless 限流）
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true
# B 站投稿页（Firecrawl actions 交互滚动）→ 取前 N 条视频梗
FIRECRAWL_BILIBILI_UPLOAD_URL=https://space.bilibili.com/94510621/upload/video
FIRECRAWL_BILIBILI_TOP_VIDEOS=5
FIRECRAWL_SCRAPE_PROXY=stealth
# 主页 / 动态兜底
FIRECRAWL_BILIBILI_DYNAMIC_URL=https://space.bilibili.com/94510621
FIRECRAWL_BILIBILI_EXTRA_URLS=https://space.bilibili.com/94510621/dynamic
# B 站无梗时的站内搜索兜底关键词，多条用 | 分隔
FIRECRAWL_DEFAULT_QUERIES=网络流行语|网络梗

