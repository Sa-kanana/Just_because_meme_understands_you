# MemeAgent 本地配置示例 — 复制为 .env 后填写，勿提交 .env

APP_NAME=meme-agent
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Java ↔ Agent 内部鉴权（与 Java meme.agent.api-key 一致）
INTERNAL_API_KEY=meme-agent-key

# PostgreSQL + pgvector（与业务 MySQL 隔离）
VECTOR_DATABASE_URL=postgresql://192.168.100.128:5432/postgres
VECTOR_EMBEDDING_DIM=1536

# OpenAI 兼容 API（embedding + chat）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=meme-agent-dev

# 检索 / 生成
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=512
